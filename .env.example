# Checkout provider switch.
# Use "kofi" until the Polar checkout links are ready, then set this to "polar".
VITE_CHECKOUT_PROVIDER=kofi

# Public browser-safe checkout links.
VITE_KOFI_HTML_TEMPLATE_ENGINE_URL=https://ko-fi.com/s/768aff36b3
VITE_KOFI_TIP_URL=https://ko-fi.com/s/768aff36b3
VITE_POLAR_HTML_TEMPLATE_ENGINE_URL=
VITE_POLAR_3D_ANIMATION_STUDIO_URL=
VITE_POLAR_TIP_URL=

# Future server-only Polar integration values.
# Do not prefix tokens with VITE_ because Vite exposes VITE_* values to the browser.
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL=https://nocode.media/?checkout_id={CHECKOUT_ID}
